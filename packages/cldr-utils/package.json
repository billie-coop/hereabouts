{
  "name": "@phensley/cldr-utils",
  "version": "1.16.0",
  "description": "Utilities for cldr-engine packages",
  "main": "lib/index.js",
  "module": "lib-es/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "author": "Billie Co-op",
  "contributors": [
    "Patrick Hensley <pathensley@gmail.com>"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billie-coop/hereabouts.git",
    "directory": "packages/cldr-utils"
  },
  "homepage": "https://billie-coop.github.io/hereabouts/",
  "bugs": {
    "url": "https://github.com/billie-coop/hereabouts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "api": "api-extractor run -c ./etc/api-extractor.json --verbose",
    "api:local": "yarn run api -l",
    "bench": "ts-node -P tsconfig.lint.json __benchmarks__/",
    "build": "yarn run build:cj && yarn run build:es && yarn run build:cjs-bundle",
    "build:cj": "tsc -p ./tsconfig.json",
    "build:es": "tsc -p ./tsconfig.json --module esnext --outDir lib-es",
    "build:cjs-bundle": "rollup -c ../../rollup.cjs.config.mjs",
    "build:lint": "tsc -p ./tsconfig.lint.json",
    "build:watch": "tsc -p ./tsconfig.json -w --preserveWatchOutput",
    "clean": "rimraf ./lib ./lib-es ./.scratch",
    "clean:full": "yarn run clean && rimraf ./node_modules",
    "coverage": "vitest run --coverage",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "files": [
    "lib/",
    "lib-es/"
  ],
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
