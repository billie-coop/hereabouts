{
  "name": "@billie-coop/hereabouts",
  "version": "1.16.0",
  "description": "Internationalization for JavaScript and TypeScript, built on Unicode CLDR: numbers, decimal math, currencies, dates and time zones, units, plurals, messages and translations",
  "main": "lib/index.js",
  "module": "lib-es/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "author": "Billie Co-op",
  "contributors": [
    "Patrick Hensley <pathensley@gmail.com>"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billie-coop/hereabouts.git",
    "directory": "packages/hereabouts"
  },
  "homepage": "https://billie-coop.github.io/hereabouts/",
  "bugs": {
    "url": "https://github.com/billie-coop/hereabouts/issues"
  },
  "keywords": [
    "cldr",
    "unicode",
    "i18n",
    "intl",
    "internationalization",
    "l10n",
    "locale",
    "translation",
    "messageformat",
    "pluralization",
    "decimal",
    "arbitrary-precision",
    "currency",
    "timezone",
    "date"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "api": "api-extractor run -c ./etc/api-extractor.json --local --verbose",
    "api:local": "yarn run api -l",
    "build": "yarn run build:cj && yarn run build:es && yarn run build:cjs-bundle && yarn run build:packs",
    "build:cj": "tsc -p ./tsconfig.json",
    "build:es": "tsc -p ./tsconfig.json --module esnext --outDir lib-es",
    "build:cjs-bundle": "rollup -c ../../rollup.cjs.config.mjs",
    "build:lint": "tsc -p ./tsconfig.lint.json",
    "build:packs": "cldr-compiler pack -o ./packs",
    "build:watch": "tsc -p ./tsconfig.json -w --preserveWatchOutput",
    "clean": "rimraf ./lib ./lib-es ./packs",
    "clean:full": "yarn run clean && rimraf ./node_modules",
    "coverage": "vitest run --coverage",
    "off-install": "node ./scripts/extract.js",
    "prepublish": "yarn run build",
    "stress": "ts-node ./__stress__",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "files": [
    "lib/",
    "lib-es/",
    "packs/*.json",
    "packs/sha*.txt",
    "packs/resource.json",
    "scripts/"
  ],
  "dependencies": {
    "@phensley/cldr-core": "workspace:~1.16.0",
    "@phensley/cldr-utils": "workspace:~1.16.0",
    "@phensley/messageformat": "workspace:~1.16.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@phensley/cldr-compiler": "workspace:~1.16.0",
    "@types/node": "^24.10.1"
  }
}
