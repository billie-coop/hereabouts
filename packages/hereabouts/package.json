{
  "name": "@billie-coop/hereabouts",
  "version": "0.1.1",
  "description": "Internationalization for JavaScript and TypeScript, built on Unicode CLDR: numbers, decimal math, currencies, dates and time zones, units, plurals, messages and translations",
  "license": "Apache-2.0",
  "author": "Billie Co-op",
  "contributors": [
    "Patrick Hensley <pathensley@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billie-coop/hereabouts.git",
    "directory": "packages/hereabouts"
  },
  "homepage": "https://billie-coop.github.io/hereabouts/",
  "bugs": {
    "url": "https://github.com/billie-coop/hereabouts/issues"
  },
  "keywords": [
    "cldr",
    "unicode",
    "i18n",
    "intl",
    "internationalization",
    "l10n",
    "locale",
    "translation",
    "messageformat",
    "pluralization",
    "decimal",
    "arbitrary-precision",
    "currency",
    "timezone",
    "date"
  ],
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "module": "./dist/esm/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./decimal": {
      "types": "./dist/types/decimal/index.d.ts",
      "module": "./dist/esm/decimal/index.js",
      "default": "./dist/cjs/decimal.js"
    },
    "./datetime": {
      "types": "./dist/types/datetime/index.d.ts",
      "module": "./dist/esm/datetime/index.js",
      "default": "./dist/cjs/datetime.js"
    },
    "./timezone": {
      "types": "./dist/types/timezone/index.d.ts",
      "module": "./dist/esm/timezone/index.js",
      "default": "./dist/cjs/timezone.js"
    },
    "./plurals": {
      "types": "./dist/types/plurals/index.d.ts",
      "module": "./dist/esm/plurals/index.js",
      "default": "./dist/cjs/plurals.js"
    },
    "./messageformat": {
      "types": "./dist/types/messageformat/index.d.ts",
      "module": "./dist/esm/messageformat/index.js",
      "default": "./dist/cjs/messageformat.js"
    },
    "./language-tag": {
      "types": "./dist/types/language-tag/index.d.ts",
      "module": "./dist/esm/language-tag/index.js",
      "default": "./dist/cjs/language-tag.js"
    },
    "./locale": {
      "types": "./dist/types/locale/index.d.ts",
      "module": "./dist/esm/locale/index.js",
      "default": "./dist/cjs/locale.js"
    },
    "./locale-matcher": {
      "types": "./dist/types/locale-matcher/index.d.ts",
      "module": "./dist/esm/locale-matcher/index.js",
      "default": "./dist/cjs/locale-matcher.js"
    },
    "./unit-converter": {
      "types": "./dist/types/unit-converter/index.d.ts",
      "module": "./dist/esm/unit-converter/index.js",
      "default": "./dist/cjs/unit-converter.js"
    },
    "./packs/*": "./packs/*",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "decimal": [
        "./dist/types/decimal/index.d.ts"
      ],
      "datetime": [
        "./dist/types/datetime/index.d.ts"
      ],
      "timezone": [
        "./dist/types/timezone/index.d.ts"
      ],
      "plurals": [
        "./dist/types/plurals/index.d.ts"
      ],
      "messageformat": [
        "./dist/types/messageformat/index.d.ts"
      ],
      "language-tag": [
        "./dist/types/language-tag/index.d.ts"
      ],
      "locale": [
        "./dist/types/locale/index.d.ts"
      ],
      "locale-matcher": [
        "./dist/types/locale-matcher/index.d.ts"
      ],
      "unit-converter": [
        "./dist/types/unit-converter/index.d.ts"
      ]
    }
  },
  "files": [
    "dist/",
    "packs/*.json",
    "packs/sha*.txt",
    "packs/resource.json",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "api": "node ./scripts/api.mjs",
    "api:local": "node ./scripts/api.mjs --local",
    "bench": "ts-node -P tsconfig.lint.json __benchmarks__/core/ && ts-node -P tsconfig.lint.json __benchmarks__/utils/ && ts-node -P tsconfig.lint.json __benchmarks__/timezone/",
    "build": "yarn run build:ts && yarn run build:cjs && yarn run build:packs",
    "build:cjs": "rollup -c ./rollup.config.mjs",
    "build:lint": "tsc -p ./tsconfig.lint.json",
    "build:packs": "cldr-compiler pack -o ./packs",
    "build:ts": "rimraf ./dist && tsc -p ./tsconfig.json",
    "build:watch": "tsc -p ./tsconfig.json -w --preserveWatchOutput",
    "clean": "rimraf ./dist ./packs ./.scratch ./.custom-packs ./temp",
    "clean:full": "yarn run clean && rimraf ./node_modules ./.tztemp",
    "coverage": "vitest run --coverage",
    "generate-factors": "jiti ./scripts/unit-converter-factors.ts",
    "generate-zones": "./scripts/tztool generate -o ./src/timezone/autogen.zonedata.ts",
    "postpack": "rm -f README.md LICENSE NOTICE",
    "prepack": "cp ../../README.md ../../LICENSE ../../NOTICE .",
    "stress": "ts-node ./__stress__",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@types/node": "^24.10.1",
    "@types/yargs": "^17.0.35",
    "cldr-compiler": "workspace:*",
    "ts-node": "^10.9.2",
    "yargs": "^17.7.2"
  }
}
