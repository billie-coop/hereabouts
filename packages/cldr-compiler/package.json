{
  "name": "@phensley/cldr-compiler",
  "version": "1.16.0",
  "description": "Compiler for @phensley/cldr",
  "main": "lib/index.js",
  "module": "lib-es/index.js",
  "types": "lib/index.d.ts",
  "author": "Billie Co-op",
  "contributors": [
    "Patrick Hensley <pathensley@gmail.com>"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billie-coop/hereabouts.git",
    "directory": "packages/cldr-compiler"
  },
  "homepage": "https://billie-coop.github.io/hereabouts/",
  "bugs": {
    "url": "https://github.com/billie-coop/hereabouts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": "./bin/compiler.js",
  "cldrversion": "48.2.0",
  "scripts": {
    "disabled:api": "api-extractor run -c ./etc/api-extractor.json --verbose",
    "disabled:api:local": "yarn run api -l",
    "build": "yarn run build:cj && yarn run build:es && yarn run download",
    "build:cj": "tsc -p ./tsconfig.json",
    "build:es": "tsc -p ./tsconfig.json --module esnext --outDir lib-es",
    "build:lint": "tsc -p ./tsconfig.lint.json",
    "build:watch": "tsc -p ./tsconfig.json -w --preserveWatchOutput",
    "clean": "rimraf ./lib ./lib-es",
    "clean:full": "yarn run clean && rimraf ./node_modules .cldr",
    "coverage": "vitest run --coverage",
    "download": "node ./scripts/downloader.js",
    "generator": "node ./scripts/generator.js",
    "prepublish": "yarn run build",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "files": [
    "bin",
    "data/cldr-patches",
    "data/patches/rbnf",
    "lib/",
    "lib-es/"
  ],
  "dependencies": {
    "@phensley/cldr-core": "workspace:~1.16.0",
    "@phensley/cldr-ext-rbnf": "workspace:~1.16.0",
    "@phensley/cldr-types": "workspace:~1.16.0",
    "@phensley/cldr-utils": "workspace:~1.16.0",
    "@phensley/decimal": "workspace:~1.16.0",
    "@phensley/timezone": "workspace:~1.16.0",
    "@prettier/sync": "^0.6.1",
    "@types/node-fetch": "^2.6.2",
    "@types/yargs": "^17.0.35",
    "chalk": "^4.1.2",
    "fast-json-patch": "^3.1.1",
    "minimatch": "^7.4.6",
    "node-fetch": "^2.6.7",
    "partial.lenses": "^14.17.0",
    "prettier": "^3.8.3",
    "tar": "^7.5.13",
    "tslib": "^2.8.1",
    "yaml": "^2.8.3",
    "yargs": "^17.7.2"
  }
}
