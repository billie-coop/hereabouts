{
  "name": "cldr-compiler",
  "version": "0.1.0",
  "description": "Build-time tool for hereabouts: turns CLDR JSON into resource packs and generated code. Runs from its TypeScript sources with tsx; not published.",
  "author": "Billie Co-op",
  "contributors": [
    "Patrick Hensley <pathensley@gmail.com>"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billie-coop/hereabouts.git",
    "directory": "packages/cldr-compiler"
  },
  "homepage": "https://billie-coop.github.io/hereabouts/",
  "bugs": {
    "url": "https://github.com/billie-coop/hereabouts/issues"
  },
  "bin": "./bin/compiler.js",
  "cldrversion": "48.2.0",
  "scripts": {
    "build": "yarn run download",
    "build:lint": "tsc -p ./tsconfig.lint.json",
    "clean": "rimraf ./lib ./lib-es ./.scratch",
    "clean:full": "yarn run clean && rimraf ./node_modules .cldr",
    "coverage": "vitest run --coverage",
    "download": "node ./scripts/downloader.js",
    "generator": "node ./scripts/generator.js",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prettier/sync": "^0.6.1",
    "@types/node-fetch": "^2.6.2",
    "@types/yargs": "^17.0.35",
    "chalk": "^4.1.2",
    "fast-json-patch": "^3.1.1",
    "minimatch": "^7.4.6",
    "node-fetch": "^2.6.7",
    "partial.lenses": "^14.17.0",
    "prettier": "^3.8.3",
    "tar": "^7.5.13",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "yaml": "^2.8.3",
    "yargs": "^17.7.2"
  },
  "private": true
}
