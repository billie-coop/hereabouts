{
  "name": "@phensley/decimal",
  "version": "1.16.0",
  "description": "Arbitrary precision decimal math",
  "main": "lib/index.js",
  "module": "lib-es/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "author": "Patrick Hensley <pathensley@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/phensley/cldr-engine/",
  "repository": {
    "type": "git",
    "url": "https://github.com/phensley/cldr-engine"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "api": "api-extractor run -c ./etc/api-extractor.json --verbose",
    "api:local": "yarn run api -l",
    "bench:off": "ts-node __benchmarks__/",
    "build": "yarn run build:cj && yarn run build:es && yarn run build:cjs-bundle",
    "build:cj": "tsc -p ./tsconfig.json",
    "build:es": "tsc -p ./tsconfig.json --module esnext --outDir lib-es",
    "build:cjs-bundle": "rollup -c ../../rollup.cjs.config.mjs",
    "build:lint": "tsc -p ./tsconfig.lint.json",
    "build:watch": "tsc -p ./tsconfig.json -w --preserveWatchOutput",
    "clean": "rimraf ./lib ./lib-es ./.scratch",
    "clean:full": "yarn run clean && rimraf ./node_modules",
    "coverage": "vitest run --coverage",
    "prepublish": "yarn run build",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "files": [
    "lib/",
    "lib-es/"
  ],
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
